# The reader (required for scanning photos and PDFs)
ANTHROPIC_API_KEY=

# Recommended for any deployment others can reach: the app asks each player for this once
# APP_PASSCODE=

# Optional
# OMR_MODEL=claude-sonnet-5-5
# OMR_EFFORT=            # low | medium | high | xhigh | max (leave unset for the model's default)
# OMR_MAX_TOKENS=32000
# OMR_RATE_LIMIT=10      # scans per address per window
# OMR_RATE_WINDOW_MIN=10
# OMR_DAILY_LIMIT=300    # scans per day for everyone together
# AUDIVERIS_URL=         # backup reader service (see audiveris-server/)
# OMR_TOKEN=             # shared secret for the backup reader
